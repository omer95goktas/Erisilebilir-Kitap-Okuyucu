<Window x:Class="ErisilebilirKitapOkuyucu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erişilebilir Kitap Okuyucu" Width="1160" Height="800" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        AutomationProperties.Name="Erişilebilir Kitap Okuyucu">
    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık, Logo ve Hızlı Eylem Çubuğu -->
        <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" ClipToBounds="True">
                        <Image x:Name="LogoImage" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Erişilebilir Kitap Okuyucu" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppFg}"/>
                    <Border Background="{DynamicResource BadgeBg}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeFg}"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="NowPlayingPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BtnNowPlaying" Content="▶ Sesli Kitaba Dön" Margin="0" Padding="12,5" MinHeight="30" FontSize="13" Style="{DynamicResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1" IsTabStop="False" Margin="16,10,16,6"/>

        <Border Grid.Row="2" Background="{DynamicResource PanelHeaderBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{DynamicResource SubTextFg}" AutomationProperties.Name="Durum çubuğu" Text="Hazır"/>
        </Border>
    </Grid>
</Window>