<Window x:Class="ErisilebilirKitapOkuyucu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erişilebilir Kitap Okuyucu" Width="1100" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        AutomationProperties.Name="Erişilebilir Kitap Okuyucu">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ContentControl x:Name="PageHost" Grid.Row="0" IsTabStop="False" Margin="16,12,16,4"/>
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,2,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" FontSize="16" AutomationProperties.Name="Durum çubuğu" Text="Hazır"/>
        </Border>
    </Grid>
</Window>
