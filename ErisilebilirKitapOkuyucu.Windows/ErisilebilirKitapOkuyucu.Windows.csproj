<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ErisilebilirKitapOkuyucu</RootNamespace>
    <AssemblyName>ErisilebilirKitapOkuyucu</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.2.0</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Erisilebilir Kitap Okuyucu</AssemblyTitle>
    <Product>Erisilebilir Kitap Okuyucu</Product>
    <Company>Omer Goktas</Company>
    <Authors>Omer Goktas</Authors>
    <Copyright>Copyright 2026 Omer Goktas</Copyright>
    <Description>Erisilebilir sesli kitap ve belge okuyucu</Description>
    <PackageProjectUrl>https://omergoktas.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/omer95goktas/Erisilebilir-Kitap-Okuyucu</RepositoryUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetName>ErisilebilirKitapOkuyucu</TargetName>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.10.46" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.10.46" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Assets\*.wav" />
  </ItemGroup>

</Project>
